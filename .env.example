# IBM Services Essentials / watsonx API
OPENAI_API_BASE=https://servicesessentials.ibm.com/apis/v3
OPENAI_API_KEY=your-api-key-here
MODEL_ID=global/anthropic.claude-sonnet-4-5-20250929-v1:0

# Pipeline configuration
MAX_CONCURRENT_CHUNKS=5

# IBM Services Essentials gateway truncates response bodies at ~14 000 chars (~3 500 output tokens).
# Default 2048 keeps JSON responses well under that ceiling.
# Raise only if using a different gateway without this constraint.
# EXTRACTION_MAX_TOKENS=2048
ARCHETYPE_THRESHOLD=0.25

# Logging
LOG_LEVEL=INFO

# Output
OUTPUT_DIR=./outputs

# Upload directory
UPLOAD_DIR=./uploads
